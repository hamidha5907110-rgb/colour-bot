# =========================================================
# Kuhi Anime API — environment template
# =========================================================
PORT=8000
PYTHONUNBUFFERED=1

# Optional tuning
KUHI_CACHE_TTL=300
KUHI_REQUEST_TIMEOUT=20
KUHI_PROVIDER_RACE_TIMEOUT=15

# Optional — if a provider needs a token/key
# SOME_PROVIDER_TOKEN=
